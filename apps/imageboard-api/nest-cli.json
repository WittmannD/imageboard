{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": "../../.swcrc",
        "stripLeadingPaths": true,
        "ignore": ["**/*.spec.ts"]
      }
    },
    "typeCheck": true
  }
}
