    "@nestjs/core": "^11.1.2",
    "@nestjs/platform-express": "^11.1.2",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "hbs": "^4.2.1",
    "ioredis": "^5.9.3",
    "mustache": "^4.2.0",
    "nodemailer": "^9.0.3",
    "oidc-provider": "^9.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/hbs": "^4.0.5",
    "@types/nodemailer": "^8.0.1",
