{
  "name": "imageboard-identity-provider",
  "version": "0.0.0",
  "description": "Open ID authentication server for imageboard",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check .",
