# Secrets for the throwaway e2e stack. Test-only values - never reuse them.
# Everything that isn't a secret comes from the e2e profile in packages/config.
DB_USER=e2e
DB_PASS=e2e
SMTP_USER=e2e
SMTP_PASS=e2e
OIDC_CLIENT_SECRET=e2e-client-secret
SESSION_COOKIE_SECRET=e2e-only-cookie-secret
# AES-256 key protecting the JWKS at rest.
JWKS_ENCRYPTION_KEY=UR/OoQVgg2pz7zV44QDIGmiCJWYawHI4Ju5yvw6RU3c=
# MinIO root credentials, doubling as the image processor's S3 keys.
S3_ACCESS_KEY_ID=e2e-access-key
S3_SECRET_ACCESS_KEY=e2e-secret-key
