# Front door for ${DOMAIN}: the client on it, the API on api.${DOMAIN} and
# the identity provider on auth.${DOMAIN}.
#
# NGINX_MODE (http or tls) is set by docker-entrypoint.d/15-select-mode.envsh;
# modes/<mode>/ holds everything that differs between plain HTTP and HTTPS.

access_log /var/log/nginx/access.log;
error_log  /var/log/nginx/error.log warn;

resolver 127.0.0.11 valid=10s;
resolver_timeout 30s;
# Inherited by every location below.
client_max_body_size 1m;
add_header X-Request-ID $request_id always;
proxy_set_header Host $host;
proxy_set_header X-Request-ID $request_id;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_connect_timeout 15s;
proxy_send_timeout 60s;
proxy_read_timeout 60s;

include /etc/nginx/conf.d/modes/${NGINX_MODE}/main.conf;

# Container healthcheck, answered by nginx itself: probing a proxied host would
# wait on DNS for an upstream that is not up yet (and the client and API only
# start once this reports healthy). Not published outside the container.
server {
    listen 127.0.0.1:8080;
    access_log off;

    location = /healthz {
        return 200 "ok\n";
    }
}

# Requests for any other host (scanners probing the bare IP) are dropped
# without a response rather than reaching an app. Certificate renewals name
# ${DOMAIN}, so they still reach the challenge location.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    include /etc/nginx/conf.d/modes/${NGINX_MODE}/server.conf;
    server_name ${DOMAIN};
    # A variable, so nginx resolves the container at request time rather than
    # failing to start while it is down.
    set $upstream ${CLIENT_INTERNAL_URL};

    location / {
        proxy_pass $upstream;
    }

    location = /api {
        # a post carries up to 5 videos of up to 50MB each (packages/config)
        client_max_body_size 260m;
        proxy_pass $upstream;
    }

    location ^~ /api/ {
        # a post carries up to 5 videos of up to 50MB each (packages/config)
        client_max_body_size 260m;
        proxy_pass $upstream;
    }
}

server {
    include /etc/nginx/conf.d/modes/${NGINX_MODE}/server.conf;
    server_name api.${DOMAIN};
    set $upstream ${API_INTERNAL_URL};

    location / {
        proxy_pass $upstream;
    }

    location /posts {
        if ($request_method !~ ^(POST|PUT)$) {
            # Bypasses the body size limit below and proxies normally
            proxy_pass $upstream;
        }

        # a post carries up to 5 videos of up to 50MB each (packages/config)
        client_max_body_size 260m;
        proxy_pass $upstream;
    }

    location /user/me/avatar {
        if ($request_method !~ ^(POST|PUT)$) {
            # Bypasses the body size limit below and proxies normally
            proxy_pass $upstream;
        }

        client_max_body_size 50m;
        proxy_pass $upstream;
    }
}

server {
    include /etc/nginx/conf.d/modes/${NGINX_MODE}/server.conf;
    server_name auth.${DOMAIN};
    set $upstream ${AUTH_SERVER_INTERNAL_URL};

    location / {
        proxy_pass $upstream;
    }
}
