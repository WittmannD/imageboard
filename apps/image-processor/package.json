{
  "name": "image-processor",
  "version": "0.0.0",
  "description": "Image processor microservice",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "build": "nest build",
