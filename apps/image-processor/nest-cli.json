{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "app",
  "compilerOptions": {
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": "../../.swcrc"
      }
    },
    "assets": [
      {
        "include": "../../config/image-processor-config.yaml",
        "outDir": "./dist"
      }
    ],
    "typeCheck": true
  }
}