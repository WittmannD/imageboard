{
  "name": "imageboard",
  "version": "0.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nx run-many -t=build",
    "build:clean": "nx exec -- del-cli dist",
    "test": "nx run-many -t=test -- --passWithNoTests",
    "lint": "nx run-many -t=lint",
    "release": "tsx ./bin/nx-release.ts",
    "config:env": "tsx ./bin/config-env.ts",
    "config:upload-transforms": "tsx ./bin/upload-transform-configs.ts",
    "stack:dev": "npm run config:env -- development && docker compose --env-file .env --env-file .generated/config.development.env up --build",
    "stack:dev:watch": "npm run config:env -- development && docker compose --env-file .env --env-file .generated/config.development.env watch"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@eslint/js": "^9.39.4",
    "@nx/docker": "^22.4.4",
    "@nx/js": "^21.1.2",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.11.29",
    "@types/node": "^22.15.26",
    "@vitest/eslint-plugin": "^1.2.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "nx": "^21.1.2",
    "prettier": "^3.8.1",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "unplugin-swc": "^1.5.3",
    "vitest": "^3.1.4"
  },
  "keywords": [],
  "author": "WittmannD"
}
