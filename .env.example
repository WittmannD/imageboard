# Secrets for every service, and nothing else: all other settings live in the
# configuration profiles in packages/config, selected with APP_ENV.
# Copy to .env and fill in. Each service validates the ones it needs at startup.

# Postgres (postgres, pgweb, imageboard-api, imageboard-identity-provider)
DB_USER=
DB_PASS=

# SMTP credentials (imageboard-identity-provider)
SMTP_USER=
SMTP_PASS=

# OIDC client secret shared by the identity provider and the client
OIDC_CLIENT_SECRET=

# Base64-encoded 32-byte AES-256 key encrypting the JWKS at rest
# (imageboard-identity-provider). Generate with: openssl rand -base64 32
JWKS_ENCRYPTION_KEY=

# Signs the client's session cookies (imageboard-client)
SESSION_COOKIE_SECRET=

# S3 / Filebase credentials (image-processor)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Placeholders for the not-yet-implemented Google login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
